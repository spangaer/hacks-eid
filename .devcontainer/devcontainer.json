// format and options: https://aka.ms/devcontainer.json
{
    "name": "hacks-eid",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // root-level setup is lost on rebuild, so redo it; safe to rerun by hand too
    "postCreateCommand": "just setup",
    // connect only after setup, so the server and its terminals start with any device group it
    // adds; groups are fixed per process, only a container restart refreshes them
    "waitFor": "postCreateCommand",
    // the services, like pcscd, as nothing starts them in a container; safe to rerun by hand
    "postStartCommand": "just start",
    // The smartcard reader's USB bus, if the user can open the reader, else the last one found,
    // or an empty dir, see usb-bus-link.sh; env/start.sh links it to /dev/bus/usb/BBB in the
    // container.
    "initializeCommand": [
        "sh",
        "${localWorkspaceFolder}/.devcontainer/usb-bus-link.sh",
        "0b",
        "smartcard-bus"
    ],
    "mounts": [
        {
            "type": "bind",
            "source": "${localWorkspaceFolder}/.local/host/smartcard-bus",
            "target": "/run/smartcard-bus"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker",
                "eamodio.gitlens",
                "github.vscode-pull-request-github"
            ],
            "settings": {
                "gitlens.gitkraken.mcp.autoEnabled": false,
                "chat.defaultConfiguration": {
                    "approvals": "assisted"
                }
                // never mind sandbox, doesn't work in podman containers
                // "chat.agent.sandbox.enabled": "on"
            }
        }
    }
}