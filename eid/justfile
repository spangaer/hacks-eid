import 'versions.just'

set shell := ["bash", "-euo", "pipefail", "-c"]

# runtime state, in the repo's .local/; run as the root's module, justfile_directory() is the
# root, hence source_directory()
local := parent_directory(source_directory()) / ".local" / "eid"

# list recipes
default:
    @just --list

# devcontainer setup: the eID repo, a polkitd stub, pcscd and the middleware; safe to rerun
setup:
    env/setup.sh {{ quote(local) }} {{ quote(eid_archive_url) }} {{ eid_archive_sha256 }}

# start pcscd, with the reader's bus linked; on start, safe to rerun
start:
    env/start.sh

# restart pcscd, to see a replugged reader, as nothing tells it in the container
restart:
    env/start.sh restart
